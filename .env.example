# Local development only. Use private, unique values; this file contains placeholders.
NODE_ENV=development
PORT=3000
ADMIN_PASSWORD=replace-with-a-private-password-at-least-16-characters
IP_ENCRYPTION_KEY=replace-with-a-private-64-character-hex-key
STORAGE_BACKEND=json-file
STORAGE_FILE=./data/visitors.json
BACKUP_DIR=./data/backups
BACKUP_RETENTION_COUNT=14
TRUST_PROXY_HOPS=0
GEO_PROVIDER=ipwho.is
GEO_TIMEOUT_MS=5000
GEO_RETRY_COUNT=1
PUBLIC_RATE_LIMIT=30
LOGIN_RATE_LIMIT=5
