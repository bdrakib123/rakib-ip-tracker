# Temporary staging only. Never reuse production credentials or storage.
NODE_ENV=production
PORT=3000
ADMIN_PASSWORD=replace-with-a-private-staging-password-at-least-16-characters
IP_ENCRYPTION_KEY=replace-with-a-new-private-64-character-hex-key
STORAGE_BACKEND=json-file
STAGING_MODE=true
STAGING_EPHEMERAL_STORAGE=true
STAGING_ACCESS_PASSWORD=replace-with-a-distinct-private-32-to-256-character-password
STAGING_STORAGE_DIR=/tmp/rakib-ip-tracker-staging
TRUST_PROXY_HOPS=0
GEO_PROVIDER=ipwho.is
GEO_TIMEOUT_MS=5000
GEO_RETRY_COUNT=1
PUBLIC_RATE_LIMIT=30
LOGIN_RATE_LIMIT=5
